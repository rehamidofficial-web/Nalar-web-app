PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/nalar_db?schema=public"
JWT_SECRET="your_jwt_secret_here"

# Konfigurasi AI (OpenAI atau Gemini OpenAI-compatible)
OPENAI_API_KEY="your_api_key_here"
OPENAI_CHAT_MODEL="gemini-3.5-flash-lite"
OPENAI_EMBEDDING_MODEL="gemini-embedding-001"
# Opsional jika memakai endpoint kompatibel seperti Gemini:
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
